    def proxima_foto(self):
        if self.lista_atual_fotos:
            self.indice_foto_atual = (self.indice_foto_atual + 1) % len(self.lista_atual_fotos)
            self.atualizar_imagem_no_visualizador()

    def foto_anterior(self):
