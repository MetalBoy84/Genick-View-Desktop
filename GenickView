class AlbumCard(QFrame):
    def __init__(self, nome_pasta, caminho_raiz, caminho_capa=None):
        super().__init__()
        self.caminho_raiz = caminho_raiz
        self.pixmap_original_limpo = None
        caminho_lock = os.path.join(self.caminho_raiz, ".lock")
        self.lacrado = os.path.exists(caminho_lock)

        self.setFixedSize(200, 280)
        self.setStyleSheet("background-color: rgba(0, 0, 0, 180); border-radius: 12px;")

        self.container_capa = QWidget(self)
        self.container_capa.setFixedSize(200, 200)

        self.capa = QLabel(self.container_capa)
        
        # 4. AGORA SIM VOCÊ PODE USAR 'self.capa'
        self.capa.setAttribute(Qt.WA_TransparentForMouseEvents)
        self.capa.setGeometry(10, 10, 180, 180)
        self.capa.setStyleSheet("background-color: #111; border-radius: 8px;")
        self.atualizar_visual_capa(caminho_capa)

        self.btn_menu = QPushButton("▼", self.container_capa)
        self.btn_menu.setGeometry(160, 15, 28, 28)
        self.btn_menu.setStyleSheet("QPushButton { background: transparent; color: white; border: 2px solid rgba(255,255,255,200); border-radius: 14px; font-weight: bold; } QPushButton:hover { border: 2px solid white; background: rgba(255,255,255,30); }")
        self.btn_menu.clicked.connect(self.abrir_menu_acoes)

        self.layout_texto = QVBoxLayout(self)
        self.layout_texto.addSpacing(195)
        self.label_nome = QLabel(nome_pasta)
        self.label_nome.setStyleSheet("""
            QLabel {
                color: white; 
                font-weight: bold; 
                font-size: 15px;      /* Aumentamos de 12 para 15 */
                background: transparent;
            }
        """)
        self.label_nome.setAlignment(Qt.AlignCenter)
        self.label_nome.setWordWrap(True)
        self.layout_texto.addWidget(self.label_nome)

        if self.lacrado:
            QTimer.singleShot(100, self.aplicar_visual_lacre_automatico)

    def obter_senha_mestra(self):
        caminho_senha = os.path.expanduser("~/.genick_key")
        if os.path.exists(caminho_senha):
            try:
                with open(caminho_senha, "r") as f: return f.read().strip()
            except: pass
        return "1234"

    def aplicar_visual_lacre_automatico(self):
        pix_original = self.capa.pixmap()
        if pix_original and not pix_original.isNull():
            self.pixmap_original_limpo = pix_original
            mini = pix_original.scaled(8, 8, Qt.IgnoreAspectRatio, Qt.FastTransformation)
            foto_borrada = mini.scaled(pix_original.size(), Qt.IgnoreAspectRatio, Qt.SmoothTransformation)
            pix_lacre = QPixmap(pix_original.size())
            painter = QPainter(pix_lacre)
            painter.drawPixmap(0, 0, foto_borrada)
            painter.setBrush(QBrush(QColor(0, 0, 0, 140)))
            painter.setPen(Qt.NoPen)
            painter.drawRect(pix_lacre.rect())
            painter.setPen(QPen(QColor(255, 215, 0, 230)))
            painter.setFont(QFont("Arial", 38, QFont.Bold))
            painter.drawText(pix_lacre.rect(), Qt.AlignCenter, "🔒")
            painter.end()
            self.capa.setPixmap(pix_lacre)
            self.capa.setStyleSheet("border: 2px solid #a00; border-radius: 8px;")

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            if self.lacrado: self.tentar_desbloquear()
            else: self.executar_abertura()

    def executar_abertura(self):
        janela = self.window()
        # O segredo: Pegamos a extensão do caminho_raiz (arquivo real), NÃO da capa
        caminho_real_lower = self.caminho_raiz.lower()
        
        if os.path.isfile(self.caminho_raiz):
            # Se o ARQUIVO ORIGINAL for vídeo, abre o player de vídeo
            if caminho_real_lower.endswith(('.mp4', '.mkv', '.avi', '.mov')):
                janela.exibir_video(self.caminho_raiz)
            else:
                # Se for imagem real, abre o visualizador de fotos
                janela.exibir_foto_cheia(self.caminho_raiz)
        else:
            janela.abrir_pasta(self.caminho_raiz, self.label_nome.text())

    def tentar_desbloquear(self):
        texto, ok = QInputDialog.getText(self, "ID-LACRE", "Chave para DESBLOQUEAR:", echo=QLineEdit.Password)
        if ok and texto.strip() == self.obter_senha_mestra():
            self.lacrado = False
            try:
                caminho_lock = os.path.join(self.caminho_raiz, ".lock")
                if os.path.exists(caminho_lock): os.remove(caminho_lock)
            except: pass
            if self.pixmap_original_limpo:
                self.capa.setPixmap(self.pixmap_original_limpo)
            self.capa.setStyleSheet("background-color: #111; border-radius: 8px; border: none;")
            self.executar_abertura()
        elif ok:
            QMessageBox.warning(self, "ERRO", "Chave incorreta!")

    def protocolo_alterar_senha(self):
        atual = self.obter_senha_mestra()
        senha_velha, ok1 = QInputDialog.getText(self, "Segurança", "Senha Atual:", echo=QLineEdit.Password)
        if ok1 and senha_velha == atual:
            nova_senha, ok2 = QInputDialog.getText(self, "Segurança", "Nova Senha:", echo=QLineEdit.Password)
            if ok2 and len(nova_senha) >= 4:
                with open(os.path.expanduser("~/.genick_key"), "w") as f:
                    f.write(nova_senha)
                QMessageBox.information(self, "Sucesso", "Chave de acesso atualizada!")

    def atualizar_visual_capa(self, caminho):
        if caminho and os.path.exists(caminho):
            pixmap = QPixmap(caminho)
            if not pixmap.isNull():
                # Faz a imagem crescer até preencher todo o 180x180, cortando as sobras
                pix_res = pixmap.scaled(180, 180, Qt.KeepAspectRatioByExpanding, Qt.SmoothTransformation)
                
                # Opcional: Centraliza o recorte caso a imagem seja muito larga
                rect = QRect(
                    (pix_res.width() - 180) // 2,
                    (pix_res.height() - 180) // 2,
                    180, 180
                )
                pix_final = pix_res.copy(rect)
                
                self.capa.setPixmap(pix_final)
                return
            self.capa.setText("🎬\nVIDEO")
            self.capa.setStyleSheet("color: #555; font-size: 20px; font-weight: bold; background-color: #1a1a1a; border-radius: 8px;")
            return
        if caminho and os.path.exists(caminho):
            pixmap = QPixmap(caminho)
            if not pixmap.isNull():
                pix_res = pixmap.scaled(140, 140, Qt.KeepAspectRatioByExpanding, Qt.SmoothTransformation)
                self.capa.setPixmap(pix_res)
                return
        self.capa.setText("🖼️")
        self.capa.setStyleSheet("color: #444; font-size: 40px; background-color: #111; border-radius: 8px;")

    def abrir_menu_acoes(self):
        menu = QMenu(self)
        menu.setStyleSheet("background-color: #222; color: white;")
        acao_bloquear = QAction("🔒 Bloquear Álbum", self)
        acao_senha = QAction("🔑 Alterar Senha Mestra", self)
        acao_renomear = QAction("📝 Renomear", self)
        acao_capa = QAction("🖼️ Alterar Miniatura", self)
        acao_bloquear.triggered.connect(self.protocolo_bloqueio)
        acao_senha.triggered.connect(self.protocolo_alterar_senha)
        acao_renomear.triggered.connect(self.solicitar_renomeio)
        acao_capa.triggered.connect(self.escolher_nova_capa)
        menu.addActions([acao_bloquear, acao_senha, acao_renomear, acao_capa])
        menu.exec(self.btn_menu.mapToGlobal(self.btn_menu.rect().bottomLeft()))

    def protocolo_bloqueio(self):
        texto, ok = QInputDialog.getText(self, "Protocolo ID-LACRE", "Chave Mestra:", echo=QLineEdit.Password)
        if ok and texto.strip() == self.obter_senha_mestra():
            self.lacrado = True
            try:
                with open(os.path.join(self.caminho_raiz, ".lock"), "w") as f: f.write("LACRADO")
            except: pass
            self.aplicar_visual_lacre_automatico()

    def solicitar_renomeio(self):
        novo_nome, ok = QInputDialog.getText(self, "Genick Edit", "Novo nome:", text=self.label_nome.text())
        if ok and novo_nome.strip():
            novo_caminho = os.path.join(os.path.dirname(self.caminho_raiz), novo_nome.strip())
            try:
                os.rename(self.caminho_raiz, novo_caminho)
                self.caminho_raiz = novo_caminho
                self.label_nome.setText(novo_nome.strip())
            except Exception as e: QMessageBox.critical(self, "Erro", str(e))

    def escolher_nova_capa(self):
        img, _ = QFileDialog.getOpenFileName(self, "Capa", self.caminho_raiz, "Imagens (*.png *.jpg *.webp)")
        if img: self.atualizar_visual_capa(img)
