    def exibir_video(self, caminho):
        self.camadas.setCurrentIndex(3)
        self.media_player.setSource(QUrl.fromLocalFile(caminho))
        self.media_player.play()
        self.btn_play_cell.setText("⏸")

    def alternar_play_pause(self):
        # Captura o estado atual do player
        estado = self.media_player.playbackState()
        
        if estado == QMediaPlayer.PlayingState:
            self.media_player.pause()
            self.btn_play_cell.setText("▶")
        else:
            # Se estiver pausado ou parado, ele inicia
            self.media_player.play()
            self.btn_play_cell.setText("⏸")

