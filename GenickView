    def mudar_volume(self, valor):
        # Converte 0-100 para 0.0-1.0
        if hasattr(self, 'audio_output'):
            self.audio_output.setVolume(valor / 100)

    def formatar_tempo(self, ms):
        """Converte milissegundos em formato MM:SS"""
        segundos = (ms // 1000) % 60
        minutos = (ms // 60000) % 60
        return f"{minutos:02d}:{segundos:02d}"

    def atualizar_posicao_tempo(self, posicao):
        # Atualiza o texto do relógio atual
        self.lbl_tempo_atual.setText(self.formatar_tempo(posicao))

    def atualizar_duracao_total(self, duracao):
        # Atualiza o texto do relógio total
        self.lbl_tempo_total.setText(self.formatar_tempo(duracao))

    def mudar_velocidade(self, vel):
        # Altera a velocidade real de reprodução
            self.media_player.setPlaybackRate(vel)
        # Atualiza o texto do botão para você saber qual está ativa
            self.btn_speed.setText(f"{vel}x")

    def processar_mudanca_velocidade(self):
        # Recupera qual ação foi clicada
        acao_clicada = self.sender()
        if acao_clicada:
            nova_vel = acao_clicada.data()
            # Aplica ao Player
            self.media_player.setPlaybackRate(nova_vel)
            # Atualiza o texto do botão para confirmar a mudança
            self.btn_speed.setText(f"{nova_vel}x")
            print(f"Velocidade alterada para: {nova_vel}") # Para você conferir no terminal

    def verificar_loop(self, status):
        # Importante: O status vem automaticamente do sinal do player
        if status == QMediaPlayer.MediaStatus.EndOfMedia:
            if self.btn_loop.isChecked():
                self.media_player.setPosition(0)
                self.media_player.play()

