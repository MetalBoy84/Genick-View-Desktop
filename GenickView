    def parar_video_e_voltar(self):
        self.media_player.stop()
        self.camadas.setCurrentIndex(1)

    def atualizar_slider(self, pos):
        # Atualiza a posição da bolinha do slider conforme o vídeo toca
        self.slider_video.setValue(pos)

    def configurar_slider(self, duracao):
        # Define o tamanho total do slider baseado no tempo do vídeo (ms)
        self.slider_video.setRange(0, duracao)

    def mudar_posicao_video(self, pos):
        # Faz o vídeo pular para onde você arrastou o slider
        self.media_player.setPosition(pos)

    def ffw_video(self):
        # Avança 10 segundos (10.000 milissegundos)
        nova_pos = self.media_player.position() + 10000
        self.media_player.setPosition(nova_pos)

    def rew_video(self):
        # Retrocede 10 segundos
        nova_pos = self.media_player.position() - 10000
        self.media_player.setPosition(max(0, nova_pos))

    def _criar_area_scroll(self, layout):
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        w = QWidget(); w.setLayout(layout)
        scroll.setWidget(w)
        return scroll

    def carregar_galeria_principal(self):
        while self.grid_home.count():
            item = self.grid_home.takeAt(0).widget()
            if item: item.deleteLater()
            
        pastas = [os.path.expanduser("~/Imagens"), os.path.expanduser("~/Downloads"), os.path.expanduser("~/Vídeos")]
        ext_img = ('.jpg', '.png', '.webp')
        ext_vid = ('.mp4', '.mkv', '.mov')
        col, lin = 0, 0
        
        for d in pastas:
            if not os.path.exists(d): continue
            for root, dirs, files in os.walk(d):
                dirs[:] = [d for d in dirs if not d.startswith('.')]
                
                # Lista todos os arquivos suportados
                arquivos = [f for f in files if f.lower().endswith(ext_img + ext_vid)]
                
                if arquivos:
                    primeiro = arquivos[0]
                    full_path_midia = os.path.join(root, primeiro)
                    capa_final = full_path_midia
                    
                    # SE FOR VÍDEO: Gera a miniatura antes de criar o card
                    if primeiro.lower().endswith(ext_vid):
                        thumb_path = os.path.join(root, ".thumb_" + primeiro + ".jpg")
                        if not os.path.exists(thumb_path):
                            self.gerar_miniatura_video(full_path_midia, thumb_path)
                        capa_final = thumb_path # Usa a miniatura gerada como capa
                    
                    card = AlbumCard(os.path.basename(root) or "Home", root, capa_final)
                    self.grid_home.addWidget(card, lin, col)
                    col += 1
                    if col >= 6: col = 0; lin += 1

    def exibir_foto_cheia(self, caminho):
        pasta = os.path.dirname(caminho)
        formatos = ('.jpg', '.jpeg', '.png', '.webp')
        self.lista_atual_fotos = sorted([os.path.join(pasta, f) for f in os.listdir(pasta) if f.lower().endswith(formatos)])
        if caminho in self.lista_atual_fotos: self.indice_foto_atual = self.lista_atual_fotos.index(caminho)
        self.atualizar_imagem_no_visualizador()
        self.camadas.setCurrentIndex(2)

    def atualizar_imagem_no_visualizador(self):
        caminho = self.lista_atual_fotos[self.indice_foto_atual]
        pix = QPixmap(caminho)
        if not pix.isNull():
            self.pixmap_item.setPixmap(pix)
            self.scene.setSceneRect(pix.rect())
            self.view.fitInView(self.scene.sceneRect(), Qt.KeepAspectRatio)

    def gerar_miniatura_video(self, caminho_video, caminho_saida_jpg):
        try:
            comando = ['ffmpeg', '-y', '-i', caminho_video, '-ss', '00:00:02', '-vframes', '1', '-s', '200x200', caminho_saida_jpg]
            subprocess.run(comando, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
            return True
        except: 
            return False

    def abrir_pasta(self, caminho, nome):
        # Limpa o grid anterior
        while self.grid_album.count():
            w = self.grid_album.takeAt(0).widget()
            if w: w.deleteLater()
            
        # --- BOTÃO VOLTAR PERSONALIZADO ---
        # Ajustado para 200x280 para combinar com o novo tamanho dos cards
        btn = QPushButton(f"⬅ Voltar\n\n{nome}")
        btn.setFixedSize(200, 280) 
        btn.setStyleSheet("""
            QPushButton {
                color: #aaa; 
                border: 2px dashed #444; 
                border-radius: 12px; 
                background: rgba(255, 255, 255, 5);
                font-weight: bold;
                font-size: 16px; /* Fonte maior para o título da pasta */
            }
            QPushButton:hover {
                color: white;
                border-color: #888;
                background: rgba(255, 255, 255, 15);
            }
        """)
        btn.clicked.connect(lambda: self.camadas.setCurrentIndex(0))
        self.grid_album.addWidget(btn, 0, 0)
        
        col, lin = 1, 0
        arquivos = sorted([
            f for f in os.listdir(caminho) 
            if f.lower().endswith(('.jpg', '.png', '.webp', '.mp4')) 
            and not f.startswith('.thumb_') # <--- ESSA É A VACINA
        ])
        
        for arq in arquivos:
            full_path = os.path.join(caminho, arq)
            ext_vid = ('.mp4', '.mkv', '.mov', '.avi')
            capa_do_card = full_path # Padrão para fotos
            
            # SE FOR VÍDEO: Tenta gerar ou usar a miniatura existente
            if arq.lower().endswith(ext_vid):
                # Cria a thumb com um nome que não conflite
                thumb_path = os.path.join(caminho, f".thumb_{arq}.jpg")
                
                if not os.path.exists(thumb_path):
                    # Chama o FFmpeg que configuramos
                    sucesso = self.gerar_miniatura_video(full_path, thumb_path)
                    if sucesso:
                        capa_do_card = thumb_path
                else:
                    capa_do_card = thumb_path

            # Cria o card com a capa correta (foto real ou thumb do vídeo)
            card = AlbumCard(arq.replace(".jpg", ""), full_path, capa_do_card)
            card.btn_menu.hide() 
            
            self.grid_album.addWidget(card, lin, col)
            
            col += 1
            # Se col >= 7, pula linha. (Ajuste para 5 ou 6 se os cards ficarem muito espremidos)
            if col >= 7: col =0; lin += 1
                
        self.camadas.setCurrentIndex(1)

